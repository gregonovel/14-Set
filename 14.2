list_awal = [1, 2, 2, 3, 4, 4, 5]
tuple_awal = (6, 7, 7, 8, 9, 9, 10)

print("=== Konversi List -> Set ===")
print("List awal :", list_awal)
set_dari_list = set(list_awal)
print("Set hasil :", set_dari_list)
print()

print("=== Konversi Set -> List ===")
print("Set awal :", set_dari_list)
list_dari_set = list(set_dari_list)
print("List hasil :", list_dari_set)
print()

print("=== Konversi Tuple -> Set ===")
print("Tuple awal :", tuple_awal)
set_dari_tuple = set(tuple_awal)
print("Set hasil :", set_dari_tuple)
print()

print("=== Konversi Set -> Tuple ===")
print("Set awal :", set_dari_tuple)
tuple_dari_set = tuple(set_dari_tuple)
print("Tuple hasil :", tuple_dari_set)
